# Environment Configuration for Food Request & Matching Service
# Local Port (Default: 5002; Render sets PORT automatically to 10000)
PORT=5002

# MongoDB Atlas Connection URI for Database 2
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/FoodRescueRequests?retryWrites=true&w=majority

# URL of Food Donation Service (Service 1)
# On Render: Set to https://<your-donation-service-name>.onrender.com
# Local: http://localhost:5001
DONATION_SERVICE_URL=http://localhost:5001

# JWT Authentication Secret (Must match Service 1)
JWT_SECRET=your_super_secret_jwt_key_foodrescue_2026
