# Environment Configuration for Food Donation Service
# Local Port (Default: 5001; Render sets PORT automatically to 10000)
PORT=5001

# MongoDB Atlas Connection URI for Database 1
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/FoodRescueDonations?retryWrites=true&w=majority

# JWT Authentication Secret (Must match across both microservices)
JWT_SECRET=your_super_secret_jwt_key_foodrescue_2026
JWT_EXPIRES_IN=7d
